# Скопируйте этот файл в .env и подставьте свои значения.
# Настоящий .env не публикуют.

# Ключ проекта Pinecone.
PINECONE_API_KEY=
# Имя готового индекса.
PINECONE_INDEX_NAME=vpg05-case-1-a-conversational
# Пустое значение: документные операции идут в пространство __default__.
PINECONE_NAMESPACE=

# Ключ OpenAI и адрес API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Модель ответов бота.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Нужны только методам менеджера, которые сами считают вектор.
# Бот для документного индекса их не вызывает.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=

# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
